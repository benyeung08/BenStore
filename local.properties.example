# 複製成 local.properties 後填入實際的值（local.properties 已在 .gitignore）
#
# 這些值也可以改用環境變數或 gradle -P 參數提供，詳見 app/build.gradle.kts 的 sec()

# ---- Google 帳號登入 ----
# 到 https://console.cloud.google.com/apis/credentials 建立
# 「網頁應用程式」型別的 OAuth 2.0 用戶端 ID
WEB_CLIENT_ID=

# 允許使用 BenStore 的帳號，逗號分隔；留空 = 不限制
# 只有在 PUBLIC_MODE = false 時才生效
ALLOWED_EMAILS=

# 網頁 OAuth 降級通道用，官方通道不需要
GOOGLE_CLIENT_SECRET=

# ---- 離線授權公鑰 ----
# 用 python3 tools/license_key.py init 產生後貼上；留空 = 停用
LICENSE_PUBKEY=
